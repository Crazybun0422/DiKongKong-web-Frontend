@import "../index/index.wxss";
.online-avatar{box-sizing:border-box;border:2px solid transparent}.online-avatar--member{border-color:#f59e0b;box-shadow:0 0 10px rgba(245,158,11,.42)}
.online-roster{padding-top:3px}.online-person{display:flex;align-items:center;gap:11px;padding:18px 0;border-bottom:1px solid #d9e9f8;min-width:0}.online-avatar{width:44px;height:44px;flex:0 0 44px;border-radius:50%;background:#edf5ff}.online-profile{flex:1;min-width:0;display:flex;flex-direction:column;align-items:flex-start;gap:5px}.online-code{font-size:14px;line-height:21px;overflow-wrap:anywhere;font-weight:600}.online-signature{max-width:100%;font-size:12px;line-height:18px;color:#7191ae;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow-wrap:anywhere}.online-aircraft{max-width:100%;box-sizing:border-box;font-size:10px;line-height:16px;padding:2px 7px;border-radius:6px;background:#edf5ff;color:#2f80ff;overflow-wrap:anywhere}.online-distance{flex:0 0 auto;font-size:13px;font-weight:600;white-space:nowrap;text-align:right;font-variant-numeric:tabular-nums}
