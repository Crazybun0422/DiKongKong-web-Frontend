{
  "name": "dikongkong-web-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:java-engine && vite build && npm run build:game-packages",
    "build:game-packages": "node scripts/build-drone-game-packages.mjs",
    "build:game-android": "node scripts/build-drone-game-packages.mjs --android-only",
    "build:java-engine": "node scripts/build-drone-java-engine.mjs",
    "check:drone-race": "npm run build:java-engine && tsc -p src/games/drone-race/tsconfig.json && node scripts/check-drone-race.mjs",
    "preview": "vite preview",
    "offline-tile-server": "node offline-tile-downloader-demo/server.js",
    "dev:lan": "vite --host 0.0.0.0",
    "check:admin-responsive": "node scripts/check-admin-responsive.cjs",
    "check:admin-settings": "node scripts/check-admin-settings.cjs"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@vueup/vue-quill": "^1.2.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.12.2",
    "cos-js-sdk-v5": "^1.10.1",
    "cropperjs": "1.6.1",
    "element-china-area-data": "^6.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "quill": "^1.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "vue": "^3.5.22",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "esbuild": "^0.25.12",
    "marked": "^18.0.14",
    "playwright": "^1.48.2",
    "typescript": "5.9",
    "vite": "^7.1.7"
  }
}
